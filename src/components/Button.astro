---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
  class?: string;
}

const { href, variant = 'primary', size = 'md', class: className = '' } = Astro.props;

const baseStyles = "inline-flex items-center justify-center font-medium transition-colors duration-300 ease-out focus:outline-none disabled:opacity-50 disabled:pointer-events-none";
const sizeStyles = size === 'md' ? "min-h-[44px] md:min-h-[48px] px-5 md:px-6 text-sm md:text-base" : "min-h-[48px] md:min-h-[56px] px-6 md:px-8 text-base md:text-lg";
const variantStyles = {
  primary: "bg-primary text-white hover:bg-primary-hover",
  secondary: "border border-border text-fg hover:border-primary hover:text-primary",
  ghost: "text-fg hover:text-primary"
};

const Tag = href ? 'a' : 'button';
---

<Tag href={href} class={`${baseStyles} ${sizeStyles} ${variantStyles[variant]} ${className}`}>
  <slot />
</Tag>
