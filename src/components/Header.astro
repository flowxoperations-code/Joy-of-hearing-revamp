---
import Icon from './Icon.astro';
import MobileNav from './MobileNav.astro';
import Button from './Button.astro';
import { contact } from '../config/contact';
import { getCollection } from 'astro:content';

const services = await getCollection('services');
const sortedServices = services.sort((a, b) => a.data.order - b.data.order).filter(s => s.data.slug !== 'hearing-aids');

// Icon + meta per service slug
const serviceMeta: Record<string, { stroke: string; bg: string; hoverBg: string; hoverText: string; desc: string; svg: string }> = {
  'hearing-assessment': {
    stroke: '#ee3137', bg: 'bg-red-50', hoverBg: 'hover:bg-red-50', hoverText: 'group-hover/item:text-red-600',
    desc: 'Full diagnostic hearing test',
    svg: `<path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/>`,
  },
  'speech-therapy': {
    stroke: '#a855f7', bg: 'bg-purple-50', hoverBg: 'hover:bg-purple-50', hoverText: 'group-hover/item:text-purple-600',
    desc: 'Communication & language rehab',
    svg: `<path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/>`,
  },
  'hearing-aids': {
    stroke: '#3b82f6', bg: 'bg-blue-50', hoverBg: 'hover:bg-blue-50', hoverText: 'group-hover/item:text-blue-600',
    desc: 'Fitting, trial & maintenance',
    svg: `<path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/>`,
  },
  'cochlear-implant': {
    stroke: '#f59e0b', bg: 'bg-amber-50', hoverBg: 'hover:bg-amber-50', hoverText: 'group-hover/item:text-amber-600',
    desc: 'Implant mapping & AVT therapy',
    svg: `<circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>`,
  },
  'pediatric-audiology': {
    stroke: '#ec4899', bg: 'bg-pink-50', hoverBg: 'hover:bg-pink-50', hoverText: 'group-hover/item:text-pink-600',
    desc: 'Hearing care for children',
    svg: `<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`,
  },
  'tinnitus-management': {
    stroke: '#06b6d4', bg: 'bg-cyan-50', hoverBg: 'hover:bg-cyan-50', hoverText: 'group-hover/item:text-cyan-600',
    desc: 'Relief for ringing in the ears',
    svg: `<path d="M2.5 18.5A10 10 0 1 1 21.5 18"/><path d="M12 2v10"/><path d="m8 18 4-4 4 4"/>`,
  },
  'hearing-protection': {
    stroke: '#22c55e', bg: 'bg-green-50', hoverBg: 'hover:bg-green-50', hoverText: 'group-hover/item:text-green-600',
    desc: 'Custom earplugs & occupational',
    svg: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>`,
  },
  'myths-and-facts': {
    stroke: '#f97316', bg: 'bg-orange-50', hoverBg: 'hover:bg-orange-50', hoverText: 'group-hover/item:text-orange-600',
    desc: 'Clearing common misconceptions',
    svg: `<line x1="12" y1="2" x2="12" y2="6"/><path d="M12 18a6 6 0 0 0 6-6 6 6 0 0 0-6-6 6 6 0 0 0-6 6 6 6 0 0 0 6 6z"/><line x1="12" y1="22" x2="12" y2="18"/><line x1="4.22" y1="4.22" x2="6.34" y2="6.34"/><line x1="17.66" y1="17.66" x2="19.78" y2="19.78"/><line x1="2" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="22" y2="12"/>`,
  },
};

const defaultMeta = {
  stroke: '#64748b', bg: 'bg-slate-50', hoverBg: 'hover:bg-slate-50', hoverText: 'group-hover/item:text-primary',
  desc: 'Clinical audiology service',
  svg: `<circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>`,
};
---

<header id="main-header" class="fixed top-9 left-0 right-0 z-50 w-full transition-all duration-300 bg-white/80 backdrop-blur-2xl border-b border-border shadow-sm">
  <div class="max-w-7xl mx-auto px-4 h-14 md:h-16 flex items-center justify-between">
    <a href={import.meta.env.BASE_URL} class="flex items-center gap-2" aria-label="Joy of Hearing Home">
      <img src={`${import.meta.env.BASE_URL}images/logo-live.svg`} alt="Joy of Hearing Logo" class="h-10 w-auto" />
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden lg:flex items-center gap-8">
      <a href={import.meta.env.BASE_URL} class="text-[14px] font-medium text-fg hover:text-primary transition-colors py-6">Home</a>
      <a href={`${import.meta.env.BASE_URL}about`} class="text-[14px] font-medium text-fg hover:text-primary transition-colors py-6">About Us</a>

      <!-- ── Services Mega-Menu ── -->
      <div class="relative group h-full flex items-center py-6">
        <a href={`${import.meta.env.BASE_URL}services`} class="text-[14px] font-medium text-fg group-hover:text-primary transition-colors flex items-center gap-1">
          Services
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-70 group-hover:rotate-180 transition-transform duration-300"><polyline points="6 9 12 15 18 9"/></svg>
        </a>

        <div class="absolute top-[100%] -left-20 w-[520px] bg-white/98 backdrop-blur-xl border border-border shadow-2xl rounded-2xl p-4 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 translate-y-2 group-hover:translate-y-0">
          <p class="text-[10px] font-black text-fg/30 uppercase tracking-[0.2em] px-2 mb-3">Our Clinical Services</p>

          <div class="grid grid-cols-2 gap-1.5">
            {sortedServices.map(service => {
              const meta = serviceMeta[service.data.slug] ?? defaultMeta;
              return (
                <a href={`${import.meta.env.BASE_URL}services/${service.data.slug}`}
                   class={`group/item flex items-start gap-3 p-3 rounded-xl border border-transparent ${meta.hoverBg} hover:border-current/10 transition-all duration-200`}>
                  <div class={`w-9 h-9 rounded-xl ${meta.bg} flex items-center justify-center shrink-0`}>
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke={meta.stroke} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" set:html={meta.svg} />
                  </div>
                  <div class="min-w-0">
                    <p class={`text-[13px] font-semibold text-fg ${meta.hoverText} transition-colors leading-tight mb-0.5`}>{service.data.title}</p>
                    <p class="text-[11px] text-fg-muted font-medium leading-tight">{meta.desc}</p>
                  </div>
                </a>
              );
            })}
          </div>

          <div class="mt-3 pt-3 border-t border-border/50 px-2">
            <a href={`${import.meta.env.BASE_URL}services`} class="text-[11px] font-semibold text-primary hover:underline">View all services →</a>
          </div>
        </div>
      </div>

      <!-- ── Hearing Aids Mega-Menu ── -->
      <div class="relative group h-full flex items-center py-6">
        <a href={`${import.meta.env.BASE_URL}services/hearing-aids`} class="text-[14px] font-medium text-fg group-hover:text-primary transition-colors flex items-center gap-1">
          Hearing Aids
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-70 group-hover:rotate-180 transition-transform duration-300"><polyline points="6 9 12 15 18 9"/></svg>
        </a>

        <div class="absolute top-[100%] -left-40 w-[500px] bg-white/98 backdrop-blur-xl border border-border shadow-2xl rounded-2xl p-4 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 translate-y-2 group-hover:translate-y-0">
          <p class="text-[10px] font-black text-fg/30 uppercase tracking-[0.2em] px-2 mb-3">Explore Hearing Aids</p>

          <div class="flex flex-col gap-2 mb-2">

            <!-- Types of Hearing Aids -->
            <a href={`${import.meta.env.BASE_URL}services/types-of-hearing-aids`}
               class="group/item flex items-start gap-4 p-4 rounded-xl hover:bg-slate-50 border border-transparent hover:border-slate-100 transition-all duration-200">
              <div class="w-11 h-11 rounded-xl bg-slate-100 flex items-center justify-center shrink-0">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#64748b" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
                  <path d="M2 12h4l2-8 5 16 3-8h6"/>
                </svg>
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-[14px] font-semibold text-fg group-hover/item:text-primary transition-colors leading-tight mb-1">Types of Hearing Aids</p>
                <p class="text-[12px] text-fg-muted font-medium leading-tight">Explore various styles, technologies, and features of modern hearing aids.</p>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary/40 shrink-0 mt-1 group-hover/item:translate-x-0.5 transition-transform"><polyline points="9 18 15 12 9 6"/></svg>
            </a>

            <!-- Hearing Aid Brands -->
            <a href={`${import.meta.env.BASE_URL}services/hearing-aid-brands`}
               class="group/item flex items-start gap-4 p-4 rounded-xl hover:bg-blue-50 border border-transparent hover:border-blue-100 transition-all duration-200">
              <div class="w-11 h-11 rounded-xl bg-blue-50 flex items-center justify-center shrink-0">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#3b82f6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>
                </svg>
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-[14px] font-semibold text-fg group-hover/item:text-blue-600 transition-colors leading-tight mb-1">Hearing Aid Brands</p>
                <p class="text-[12px] text-fg-muted font-medium leading-tight">Discover premium global brands and find the perfect match for your lifestyle.</p>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary/40 shrink-0 mt-1 group-hover/item:translate-x-0.5 transition-transform"><polyline points="9 18 15 12 9 6"/></svg>
            </a>

          </div>

          <div class="mt-2 pt-3 border-t border-border/50 px-2">
            <a href={`${import.meta.env.BASE_URL}services/hearing-aids`} class="text-[12px] font-semibold text-primary hover:underline">View full Hearing Aids guide →</a>
          </div>
        </div>
      </div>

      <!-- ── Screening Mega-Menu ── -->
      <div class="relative group h-full flex items-center py-6">
        <a href={`${import.meta.env.BASE_URL}assessment`} class="text-[14px] font-medium text-fg group-hover:text-primary transition-colors flex items-center gap-1">
          Screening
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-70 group-hover:rotate-180 transition-transform duration-300"><polyline points="6 9 12 15 18 9"/></svg>
        </a>

        <div class="absolute top-[100%] -left-32 w-[440px] bg-white/98 backdrop-blur-xl border border-border shadow-2xl rounded-2xl p-4 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 translate-y-2 group-hover:translate-y-0">
          <p class="text-[10px] font-black text-fg/30 uppercase tracking-[0.2em] px-2 mb-3">Free Online Screenings</p>

          <div class="flex flex-col gap-2">

            <!-- Hearing Screening -->
            <a href={`${import.meta.env.BASE_URL}assessment?mode=hearing`}
               class="group/item flex items-start gap-4 p-4 rounded-xl border border-border/50 hover:border-primary/20 hover:bg-red-50/50 transition-all duration-200">
              <div class="w-11 h-11 rounded-2xl bg-primary/10 flex items-center justify-center shrink-0 group-hover/item:bg-primary/15 transition-colors">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#ee3137" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
                  <path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/>
                </svg>
              </div>
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2 mb-1">
                  <p class="text-[14px] font-semibold text-fg group-hover/item:text-primary transition-colors leading-tight">Hearing Screening</p>
                  <span class="text-[9px] font-black uppercase tracking-wider bg-primary/10 text-primary rounded-full px-2 py-0.5">2 min</span>
                </div>
                <p class="text-[12px] text-fg-muted font-medium leading-tight">Quick self-assessment for hearing loss. Available in English, Hindi &amp; Punjabi.</p>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary/40 shrink-0 mt-1 group-hover/item:translate-x-0.5 transition-transform"><polyline points="9 18 15 12 9 6"/></svg>
            </a>

            <!-- Speech & Language Screening -->
            <a href={`${import.meta.env.BASE_URL}assessment?mode=speech`}
               class="group/item flex items-start gap-4 p-4 rounded-xl border border-border/50 hover:border-purple-200 hover:bg-purple-50/50 transition-all duration-200">
              <div class="w-11 h-11 rounded-2xl bg-purple-50 flex items-center justify-center shrink-0 group-hover/item:bg-purple-100 transition-colors">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#a855f7" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
                  <!-- Speech bubble with language lines -->
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                  <line x1="9" y1="9" x2="15" y2="9" stroke-width="1.3"/>
                  <line x1="9" y1="12.5" x2="13" y2="12.5" stroke-width="1.3"/>
                </svg>
              </div>
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2 mb-1">
                  <p class="text-[14px] font-semibold text-fg group-hover/item:text-purple-600 transition-colors leading-tight">Speech &amp; Language Screening</p>
                  <span class="text-[9px] font-black uppercase tracking-wider bg-purple-50 text-purple-600 rounded-full px-2 py-0.5">2 min</span>
                </div>
                <p class="text-[12px] text-fg-muted font-medium leading-tight">Assess communication skills across all age groups — children to seniors.</p>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-purple-300 shrink-0 mt-1 group-hover/item:translate-x-0.5 transition-transform"><polyline points="9 18 15 12 9 6"/></svg>
            </a>

          </div>

          <!-- CTA note -->
          <div class="mt-3 pt-3 border-t border-border/50 px-2 flex items-center justify-between">
            <p class="text-[11px] text-fg-muted font-medium">Free · No registration required</p>
            <a href={`${import.meta.env.BASE_URL}assessment`} class="text-[11px] font-semibold text-primary hover:underline">Start screening →</a>
          </div>
        </div>
      </div>

      <a href={`${import.meta.env.BASE_URL}careers`} class="text-[14px] font-medium text-fg hover:text-primary transition-colors py-6">Careers</a>
      <a href={`${import.meta.env.BASE_URL}blog`} class="text-[14px] font-medium text-fg hover:text-primary transition-colors py-6">Blog</a>
      <a href={`${import.meta.env.BASE_URL}contact`} class="text-[14px] font-medium text-fg hover:text-primary transition-colors">Contact</a>
    </nav>

    <div class="hidden md:flex items-center gap-6">
      <a href={`tel:${contact.primaryPhone}`} class="flex items-center gap-2 text-[14px] font-medium text-fg hover:text-primary transition-colors">
        <Icon name="phone" size={16} class="text-primary" />
        {contact.primaryPhone}
      </a>
      <a href={`${import.meta.env.BASE_URL}contact`} class="inline-flex items-center justify-center rounded-full border-2 border-secondary text-secondary bg-transparent hover:bg-secondary hover:text-white transition-all duration-300 px-5 py-2 text-[13px] font-semibold">Book Appointment</a>
    </div>

    <!-- Mobile Nav Toggle -->
    <div class="lg:hidden">
      <MobileNav />
    </div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const header = document.getElementById('main-header');
    if (!header) return;

    window.addEventListener('scroll', () => {
      if (window.scrollY > 36) {
        header.classList.remove('top-9');
        header.classList.add('top-0');
      } else {
        header.classList.add('top-9');
        header.classList.remove('top-0');
      }
    }, { passive: true });
  });
</script>
