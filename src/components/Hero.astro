---
import Button from './Button.astro';
import { telHref } from '../config/contact';

interface Props {
  title: string;
  subtitle: string;
  imagePath?: string;
}

const { title, subtitle, imagePath } = Astro.props;
---
<section class="py-12 md:py-20 max-w-7xl mx-auto px-4">
  <div class="flex flex-col lg:flex-row items-center gap-6 md:gap-12 lg:gap-20">
    <div class="flex-1 text-center lg:text-left">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-fg mb-6 leading-tight tracking-tight">
        {title}
      </h1>
      <p class="text-lg md:text-xl text-fg-muted mb-8 max-w-2xl mx-auto lg:mx-0">
        {subtitle}
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
        <Button href={`${import.meta.env.BASE_URL}contact`} size="lg" class="w-full sm:w-auto primary-cta-in-view">
          Book Appointment
        </Button>
        <Button href={telHref} variant="ghost" size="lg" class="w-full sm:w-auto">
          Call Now
        </Button>
      </div>
    </div>
    
    <div class="flex-1 w-full relative">
      <div class="aspect-[4/3] md:aspect-video lg:aspect-square bg-primary-soft rounded-2xl overflow-hidden shadow-lg relative">
        <div class="absolute inset-0 flex items-center justify-center text-primary/40 font-medium">
          Hero Image (1280x1280 AVIF)
        </div>
      </div>
    </div>
  </div>
</section>
