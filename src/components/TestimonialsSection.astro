---
import { getCollection } from 'astro:content';
const all = await getCollection('testimonials');
---

<section class="py-12 md:py-20 bg-bg-soft border-t border-border/50 overflow-hidden">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-14 reveal opacity-0 translate-y-6 transition-all duration-1000 ease-out">
      <h2 class="text-4xl md:text-6xl font-semibold tracking-tighter text-fg mb-3">Patient Stories.</h2>
      <p class="text-lg text-fg-muted font-medium">Real outcomes from real people across Punjab.</p>
    </div>

    <!-- Infinite scroll ticker -->
    <div class="relative">
      <!-- Fade edges -->
      <div class="pointer-events-none absolute inset-y-0 left-0 w-24 bg-gradient-to-r from-bg-soft to-transparent z-10"></div>
      <div class="pointer-events-none absolute inset-y-0 right-0 w-24 bg-gradient-to-l from-bg-soft to-transparent z-10"></div>

      <div id="testimonial-track" class="flex gap-6 w-max">
        {[...all, ...all].map((t, i) => (
          <div
            key={i}
            class="w-80 shrink-0 bg-white rounded-[28px] p-8 border border-border/40 shadow-sm flex flex-col justify-between"
          >
            <!-- Stars -->
            <div class="flex gap-1 mb-4">
              {Array.from({ length: t.data.rating }).map((_, si) => (
                <svg key={si} class="w-3.5 h-3.5 fill-secondary text-secondary" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>

            <p class="text-fg font-medium leading-relaxed text-[15px] flex-1 mb-6">
              "{t.data.quote}"
            </p>

            <div class="flex items-center gap-3">
              <div class={`w-11 h-11 rounded-full flex items-center justify-center font-bold text-sm shrink-0 text-white shadow-md`}
                style={`background: ${{
                  A:'linear-gradient(135deg,#f97316,#ef4444)',
                  B:'linear-gradient(135deg,#8b5cf6,#6366f1)',
                  C:'linear-gradient(135deg,#06b6d4,#3b82f6)',
                  D:'linear-gradient(135deg,#10b981,#059669)',
                  E:'linear-gradient(135deg,#f59e0b,#f97316)',
                  F:'linear-gradient(135deg,#ec4899,#a855f7)',
                  G:'linear-gradient(135deg,#EE3137,#f97316)',
                  H:'linear-gradient(135deg,#14b8a6,#06b6d4)',
                  I:'linear-gradient(135deg,#6366f1,#8b5cf6)',
                  J:'linear-gradient(135deg,#f43f5e,#ec4899)',
                  K:'linear-gradient(135deg,#84cc16,#10b981)',
                  L:'linear-gradient(135deg,#0ea5e9,#6366f1)',
                  M:'linear-gradient(135deg,#EE3137,#dc2626)',
                  N:'linear-gradient(135deg,#f97316,#fbbf24)',
                  O:'linear-gradient(135deg,#a855f7,#ec4899)',
                  P:'linear-gradient(135deg,#3b82f6,#06b6d4)',
                  Q:'linear-gradient(135deg,#22c55e,#10b981)',
                  R:'linear-gradient(135deg,#ef4444,#f97316)',
                  S:'linear-gradient(135deg,#6366f1,#3b82f6)',
                  T:'linear-gradient(135deg,#14b8a6,#22c55e)',
                  U:'linear-gradient(135deg,#f59e0b,#ef4444)',
                  V:'linear-gradient(135deg,#8b5cf6,#ec4899)',
                  W:'linear-gradient(135deg,#0ea5e9,#10b981)',
                  X:'linear-gradient(135deg,#f43f5e,#f97316)',
                  Y:'linear-gradient(135deg,#eab308,#f97316)',
                  Z:'linear-gradient(135deg,#06b6d4,#6366f1)',
                }[t.data.firstName.charAt(0).toUpperCase()] || 'linear-gradient(135deg,#EE3137,#f97316)'}`}>
                {t.data.firstName.charAt(0).toUpperCase()}
              </div>
              <div>
                <p class="text-fg font-semibold text-sm">{t.data.firstName}</p>
                {t.data.city && <p class="text-fg-muted text-xs font-medium">{t.data.city}</p>}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const track = document.getElementById('testimonial-track') as HTMLElement;
  if (track) {
    const totalWidth = track.scrollWidth / 2;
    let pos = 0;
    let paused = false;

    track.addEventListener('mouseenter', () => paused = true);
    track.addEventListener('mouseleave', () => paused = false);

    function animate() {
      if (!paused) {
        pos += 0.5;
        if (pos >= totalWidth) pos = 0;
        track.style.transform = `translateX(-${pos}px)`;
      }
      requestAnimationFrame(animate);
    }
    animate();
  }
</script>
