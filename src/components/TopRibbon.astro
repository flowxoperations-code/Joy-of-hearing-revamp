---
import { getCollection } from 'astro:content';
const branches = (await getCollection('branches')).sort((a, b) => a.data.order - b.data.order);
---

<div id="top-ribbon" class="w-full bg-secondary text-white/80 text-[12px] font-medium border-b border-white/10 z-[60] relative">
  <div class="max-w-7xl mx-auto px-4 h-9 flex items-center justify-between gap-4">

    <!-- Left: Branch selector -->
    <div class="relative group flex items-center gap-1.5 cursor-pointer select-none">
      <svg class="w-3.5 h-3.5 text-primary shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
      </svg>
      <span class="text-white/80 hover:text-white transition-colors">Select Clinic</span>
      <svg class="w-3 h-3 text-white/50 group-hover:text-white transition-colors" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
      </svg>

      <!-- Dropdown -->
      <div class="absolute top-full left-0 mt-1 w-52 bg-secondary-soft rounded-xl shadow-2xl border border-white/10 overflow-hidden
                  opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 translate-y-1 group-hover:translate-y-0 z-50">
        {branches.map(b => (
          <a
            href={`${import.meta.env.BASE_URL}branches/${b.data.slug}`}
            class="flex items-center gap-2 px-4 py-2.5 text-white/80 hover:text-white hover:bg-white/10 transition-colors text-[13px]"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-primary shrink-0"></span>
            {b.data.name}
          </a>
        ))}
      </div>
    </div>

    <!-- Right: hours + language selector -->
    <div class="flex items-center gap-4 ml-auto">
      <span class="hidden sm:flex items-center gap-1.5 text-white/60">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10"/><path stroke-linecap="round" d="M12 6v6l4 2"/>
        </svg>
        Mon–Sat, 10 AM – 7 PM
      </span>

      <!-- Language selector: hidden on /assessment (the quiz has its own switcher) -->
      <div id="ribbon-lang-selector" class="relative group flex items-center gap-1.5 cursor-pointer select-none">
        <svg class="w-3.5 h-3.5 text-primary shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"/>
        </svg>
        <span id="lang-label" class="text-white/80 hover:text-white transition-colors">English</span>
        <svg class="w-3 h-3 text-white/50 group-hover:text-white transition-colors" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
        </svg>

        <div class="absolute top-full right-0 mt-1 w-44 bg-secondary-soft rounded-xl shadow-2xl border border-white/10 overflow-hidden
                    opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 translate-y-1 group-hover:translate-y-0 z-50">
          {[
            { code: 'en', label: 'English' },
            { code: 'pa', label: 'ਪੰਜਾਬੀ (Punjabi)' },
            { code: 'hi', label: 'हिन्दी (Hindi)' },
          ].map(lang => (
            <button
              data-lang={lang.code}
              data-label={lang.label}
              class="lang-btn w-full flex items-center gap-2 px-4 py-2.5 text-white/80 hover:text-white hover:bg-white/10 transition-colors text-[13px] text-left"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-primary shrink-0"></span>
              {lang.label}
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Google Translate (hidden) -->
<div id="google_translate_element" class="hidden"></div>

<script>
  // Google Translate must not run on /assessment — it mutates text nodes into <font>
  // elements which corrupts React's virtual DOM before hydration, breaking all event
  // handlers. The assessment quiz has its own built-in language selector.
  const isAssessmentPage = window.location.pathname.includes('/assessment');

  // Hide the ribbon language selector on the assessment page — the quiz provides its own.
  if (isAssessmentPage) {
    const ribbonLang = document.getElementById('ribbon-lang-selector');
    if (ribbonLang) ribbonLang.style.display = 'none';
  }

  if (!isAssessmentPage) {
    // Google Translate init
    (window as any).googleTranslateElementInit = function () {
      new (window as any).google.translate.TranslateElement(
        { pageLanguage: 'en', includedLanguages: 'en,hi,pa', autoDisplay: false },
        'google_translate_element'
      );
    };

    const gtScript = document.createElement('script');
    gtScript.src = '//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit';
    gtScript.async = true;
    document.head.appendChild(gtScript);

    // Wire up our custom lang buttons to the hidden Google Translate widget
    document.querySelectorAll<HTMLButtonElement>('.lang-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const langCode = btn.dataset.lang!;
        const label = btn.dataset.label!;
        const label_el = document.getElementById('lang-label');
        if (label_el) label_el.textContent = label.split(' ')[0];

        // Trigger the hidden select inside Google Translate widget
        const select = document.querySelector<HTMLSelectElement>('.goog-te-combo');
        if (select) {
          select.value = langCode;
          select.dispatchEvent(new Event('change'));
        }
      });
    });
  }
</script>
