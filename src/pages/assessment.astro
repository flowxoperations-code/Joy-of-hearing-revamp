---
import BaseLayout from '../layouts/BaseLayout.astro';
import AssessmentQuiz from '../components/AssessmentQuiz';
---

<BaseLayout title="Online Hearing Test & Screening | Joy of Hearing" description="Take our free 2-minute online hearing screening test. Evaluate your hearing health from home and consult expert audiologists at Joy of Hearing.">
  <section class="min-h-[90vh] bg-secondary relative overflow-hidden flex items-center pt-12 md:pt-16 pb-8">
    <!-- Ambient glow -->
    <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-primary/10 rounded-full blur-[120px] pointer-events-none mix-blend-screen translate-x-1/3 -translate-y-1/3"></div>
    <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-blue-500/10 rounded-full blur-[100px] pointer-events-none mix-blend-screen -translate-x-1/3 translate-y-1/3"></div>

    <div class="max-w-6xl mx-auto px-4 w-full relative z-10">
      <div class="text-center mb-8 reveal opacity-0 translate-y-6 transition-all duration-1000 ease-out">
        <span class="text-primary font-bold tracking-[0.2em] uppercase text-xs md:text-sm mb-2 block">Self-Evaluation</span>
        <h1 id="assessment-title" class="text-3xl md:text-5xl lg:text-6xl font-semibold tracking-tighter text-white mb-3 leading-tight">
          Free Online <span class="text-primary drop-shadow-[0_0_15px_rgba(238,49,55,0.3)]">Screening.</span>
        </h1>
        <p id="assessment-desc" class="text-lg md:text-xl text-white/70 font-medium max-w-2xl mx-auto leading-relaxed">
          Select a screening below to get instant insights into your hearing or speech health.
        </p>
      </div>

      <div class="min-h-[420px] flex items-start justify-center">
        <AssessmentQuiz client:only="react" />
      </div>
    </div>
  </section>
</BaseLayout>
