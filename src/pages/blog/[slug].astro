---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import BlogControls from '../../components/BlogControls';

export async function getStaticPaths() {
  const blogs = await getCollection('blogs');
  return blogs.map(blog => ({
    params: { slug: blog.data.slug },
    props: { blog },
  }));
}

const { blog } = Astro.props;
const { Content } = await render(blog);

const services = await getCollection('services');
const topServices = services.sort((a, b) => a.data.order - b.data.order);

const allBlogs = await getCollection('blogs');
const recentBlogs = allBlogs
  .filter(b => b.data.slug !== blog.data.slug)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
---

<BaseLayout title={`${blog.data.title} | Joy of Hearing`} description={blog.data.seoDescription || blog.data.excerpt}>
  <!-- BlogPosting Schema Markup -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": blog.data.title,
    "description": blog.data.seoDescription || blog.data.excerpt,
    "datePublished": blog.data.date.toISOString(),
    "author": {
      "@type": "Person",
      "name": blog.data.author || "Joy of Hearing Clinical Team"
    },
    "publisher": {
      "@type": "Organization",
      "name": "Joy of Hearing",
      "logo": {
        "@type": "ImageObject",
        "url": `${Astro.url.origin}/images/logo-live.svg`
      }
    },
    "image": blog.data.heroImage ? (blog.data.heroImage.src.startsWith('http') ? blog.data.heroImage.src : `${Astro.url.origin}${blog.data.heroImage.src}`) : undefined,
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": Astro.url.href
    }
  })} />
  <div class="pt-32 pb-16 max-w-7xl mx-auto px-4 flex flex-col lg:flex-row gap-12 lg:gap-20 items-start">
    <article class="flex-1 w-full max-w-3xl mx-auto lg:mx-0">
    <nav aria-label="Breadcrumb" class="mb-10 reveal opacity-0 translate-y-6 transition-all duration-1000 ease-out">
      <ol class="flex items-center space-x-2 text-sm font-medium text-fg-muted overflow-hidden whitespace-nowrap">
        <li>
          <a href={`${import.meta.env.BASE_URL}`} class="hover:text-primary transition-colors">Home</a>
        </li>
        <li>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-fg-muted/40"><path d="m9 18 6-6-6-6"/></svg>
        </li>
        <li>
          <a href={`${import.meta.env.BASE_URL}blog`} class="hover:text-primary transition-colors">Blog</a>
        </li>
        <li>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-fg-muted/40"><path d="m9 18 6-6-6-6"/></svg>
        </li>
        <li>
          <a href={`${import.meta.env.BASE_URL}blog/category/${(blog.data.category || 'General').toLowerCase().replace(/\s+/g, '-')}`} class="hover:text-primary transition-colors">{blog.data.category || 'General'}</a>
        </li>
        <li>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-fg-muted/40"><path d="m9 18 6-6-6-6"/></svg>
        </li>
        <li class="text-fg truncate max-w-[150px] sm:max-w-[300px] md:max-w-[400px]" aria-current="page">
          {blog.data.title}
        </li>
      </ol>
    </nav>

    <div class="mb-12 text-center reveal opacity-0 translate-y-6 transition-all duration-1000 delay-100 ease-out">
      <div class="flex items-center justify-center gap-3 text-sm font-medium text-primary mb-4">
        <span class="px-4 py-1.5 rounded-full bg-primary/10">{blog.data.category}</span>
        <span class="text-fg-muted">{blog.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
      </div>
      <h1 class="text-4xl md:text-6xl font-semibold tracking-tighter text-fg mb-8 leading-tight">
        {blog.data.title}
      </h1>
      <div class="flex items-center justify-center gap-4 text-fg-muted font-medium">
        <div class="w-14 h-14 rounded-full bg-bg-soft flex items-center justify-center text-primary border border-border">
          <Icon name="user" size={24} />
        </div>
        <div class="text-left">
          <p class="text-lg text-fg font-semibold">{blog.data.author}</p>
          <p class="text-sm">Joy of Hearing Clinical Team</p>
        </div>
      </div>
    </div>

    {blog.data.heroImage && (
      <div class="rounded-[32px] overflow-hidden mb-12 reveal opacity-0 translate-y-6 transition-all duration-1000 delay-200 ease-out shadow-xl">
        <Image src={blog.data.heroImage} alt={blog.data.title} class="w-full h-auto" />
      </div>
    )}

    <div class="reveal opacity-0 translate-y-6 transition-all duration-1000 delay-300 ease-out">
      <BlogControls client:load title={blog.data.title} />
    </div>

    <div class="prose prose-lg max-w-none prose-headings:font-semibold prose-headings:tracking-tighter prose-headings:text-fg prose-p:text-fg-muted prose-p:font-medium prose-p:leading-relaxed prose-a:text-primary hover:prose-a:text-primary-hover reveal opacity-0 translate-y-6 transition-all duration-1000 delay-400 ease-out">
      <Content />
    </div>
  </article>

  <aside class="w-full lg:w-[340px] shrink-0 hidden lg:block sticky top-32 reveal opacity-0 translate-y-6 transition-all duration-1000 ease-out">
    <h2 class="text-xs font-semibold text-fg-muted uppercase tracking-[0.2em] mb-6">Recent Articles</h2>
    <div class="flex flex-col gap-6">
      {recentBlogs.map(recent => (
        <a href={`${import.meta.env.BASE_URL}blog/${recent.data.slug}`} class="group block p-4 rounded-2xl hover:bg-secondary/5 transition-colors border border-transparent hover:border-border/50">
          <div class="flex items-center gap-2 text-[10px] font-semibold text-primary uppercase tracking-wider mb-2">
            <span>{recent.data.category}</span>
          </div>
          <h3 class="text-sm font-semibold text-fg leading-snug group-hover:text-primary transition-colors mb-2 line-clamp-2">{recent.data.title}</h3>
          <p class="text-xs text-fg-muted font-medium line-clamp-2">{recent.data.excerpt}</p>
        </a>
      ))}
    </div>
  </aside>
</div>

  <!-- Related Services Internal Linking -->
  <section class="max-w-4xl mx-auto px-4 pb-20 reveal opacity-0 translate-y-6 transition-all duration-1000 ease-out">
    <div class="border-t border-border/50 pt-12">
      <h2 class="text-xl font-semibold text-fg mb-6 text-center">Explore Our Clinical Services</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
        {topServices.map(service => (
          <a href={`${import.meta.env.BASE_URL}services/${service.data.slug}`} class="block p-5 rounded-2xl bg-secondary/5 border border-border/50 hover:bg-secondary/10 hover:border-border transition-all text-center group">
            <h4 class="text-sm font-semibold text-fg group-hover:text-primary transition-colors mb-1.5">{service.data.title}</h4>
            <p class="text-xs text-fg-muted font-medium line-clamp-2">{service.data.excerpt}</p>
          </a>
        ))}
      </div>
      <div class="mt-6 text-center">
        <a href={`${import.meta.env.BASE_URL}services`} class="text-sm font-semibold text-primary hover:underline">View all clinical services &rarr;</a>
      </div>
    </div>
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.remove('opacity-0', 'translate-y-10');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1, rootMargin: "0px 0px -50px 0px" });

      document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    });
  </script>
</BaseLayout>
