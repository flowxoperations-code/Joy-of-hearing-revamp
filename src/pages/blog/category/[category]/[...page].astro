---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Icon from '../../../../components/Icon.astro';
import { Image } from 'astro:assets';

export async function getStaticPaths({ paginate }) {
  const blogs = await getCollection('blogs');
  const sortedBlogs = blogs.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  
  const FINAL_CATEGORIES = [
    "Hearing Loss",
    "Hearing Aids",
    "Tinnitus",
    "Cochlear Implants",
    "Speech Therapy",
    "Child Development",
    "Hearing Protection",
    "Communication Tips",
    "Medical Conditions",
    "Balance Disorders",
    "Learning Disabilities",
    "Swallowing Disorders"
  ];
  
  return FINAL_CATEGORIES.flatMap(category => {
    const filteredBlogs = sortedBlogs.filter(b => (b.data.category || 'General') === category);
    const slug = category.toLowerCase().replace(/\s+/g, '-');
    
    // Even if empty, we might want to generate the route so it doesn't 404,
    // but paginate handles empty arrays by generating one empty page.
    return paginate(filteredBlogs, {
      params: { category: slug },
      pageSize: 15,
      props: { categoryName: category }
    });
  });
}

const { page, categoryName } = Astro.props;
const { category } = Astro.params;

// We still need all blogs to calculate category counts globally for the sidebar
const allBlogs = await getCollection('blogs');

const FINAL_CATEGORIES = [
  "Hearing Loss",
  "Hearing Aids",
  "Tinnitus",
  "Cochlear Implants",
  "Speech Therapy",
  "Child Development",
  "Hearing Protection",
  "Communication Tips",
  "Medical Conditions",
  "Balance Disorders",
  "Learning Disabilities",
  "Swallowing Disorders"
];

// Get unique categories and their counts globally
const categoryCounts = allBlogs.reduce((acc, blog) => {
  const cat = blog.data.category || 'General';
  acc[cat] = (acc[cat] || 0) + 1;
  return acc;
}, {} as Record<string, number>);

const categoriesWithCounts = FINAL_CATEGORIES.map(cat => [cat, categoryCounts[cat] || 0]).filter(([, count]) => count > 0);

function getReadingTime(body: string): string {
  const words = body.trim().split(/\s+/).length;
  return `${Math.max(1, Math.ceil(words / 200))} min`;
}
---

<BaseLayout 
  title={`${categoryName} Articles & Guides | Joy of Hearing`}
  description={`Explore expert articles and practical guides on ${categoryName.toLowerCase()} from the clinical team at Joy of Hearing.`}
>
  <section class="pt-32 pb-16 max-w-7xl mx-auto px-4 border-b border-border/50">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="Breadcrumb" class="mb-6 reveal opacity-0 translate-y-6 transition-all duration-1000 ease-out">
      <ol class="flex items-center space-x-2 text-sm font-medium text-fg-muted overflow-hidden whitespace-nowrap">
        <li>
          <a href={`${import.meta.env.BASE_URL}`} class="hover:text-primary transition-colors">Home</a>
        </li>
        <li>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-fg-muted/40"><path d="m9 18 6-6-6-6"/></svg>
        </li>
        <li>
          <a href={`${import.meta.env.BASE_URL}blog`} class="hover:text-primary transition-colors">Blog</a>
        </li>
        <li>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-fg-muted/40"><path d="m9 18 6-6-6-6"/></svg>
        </li>
        <li class="text-fg truncate" aria-current="page">
          {categoryName}
        </li>
      </ol>
    </nav>

    <div class="max-w-3xl">
      <h1 class="reveal opacity-0 translate-y-6 transition-all duration-1000 ease-out text-4xl md:text-5xl lg:text-6xl font-semibold tracking-tighter text-fg mb-4 leading-[0.95]">
        {categoryName}
      </h1>
      <p class="reveal opacity-0 translate-y-6 transition-all duration-1000 delay-200 ease-out text-xl md:text-2xl text-fg-muted font-medium leading-relaxed">
        Articles and resources related to {categoryName.toLowerCase()}.
      </p>
    </div>
  </section>

  <section class="py-16 max-w-7xl mx-auto px-4 flex flex-col lg:flex-row gap-6 md:gap-12 lg:gap-20">
    
    <!-- Minimalist Apple-Style Sidebar -->
    <aside class="w-full lg:w-64 shrink-0">
      <div class="sticky top-32">
        <h3 class="text-xs font-semibold text-fg-muted uppercase tracking-[0.2em] mb-6">Categories</h3>
        <ul class="space-y-1 flex flex-row lg:flex-col overflow-x-auto lg:overflow-y-auto lg:max-h-[calc(100vh-12rem)] pb-4 lg:pb-0 scrollbar-hide">
          <li>
            <a href={`${import.meta.env.BASE_URL}blog`} class="category-btn whitespace-nowrap px-4 py-2 lg:px-0 lg:py-2.5 w-full text-left flex items-center justify-between text-fg-muted hover:text-fg font-medium rounded-full lg:rounded-none lg:border-b lg:border-border/50 transition-all hover:bg-secondary/5 lg:hover:bg-transparent">
              <span>All Articles</span>
              <span class="text-xs font-medium bg-secondary/10 px-2 py-0.5 rounded-full">{allBlogs.length}</span>
            </a>
          </li>
          {categoriesWithCounts.map(([catName, count]) => {
            const catSlug = catName.toString().toLowerCase().replace(/\s+/g, '-');
            const isActive = category === catSlug;
            return (
              <li>
                <a href={`${import.meta.env.BASE_URL}blog/category/${catSlug}`} class={`category-btn whitespace-nowrap px-4 py-2 lg:px-0 lg:py-2.5 w-full text-left flex items-center justify-between font-medium rounded-full lg:rounded-none lg:border-b lg:border-border/50 transition-all ${isActive ? 'text-fg bg-secondary/5 lg:bg-transparent' : 'text-fg-muted hover:text-fg hover:bg-secondary/5 lg:hover:bg-transparent'}`}>
                  <span>{catName}</span>
                  <span class={`text-xs font-medium px-2 py-0.5 rounded-full ${isActive ? 'text-fg-muted bg-secondary/10' : 'bg-secondary/10'}`}>{count}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </aside>

    <!-- Blog Grid -->
    <div class="flex-1 flex flex-col">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10">
        {page.data.map((blog, index) => (
          <a href={`${import.meta.env.BASE_URL}blog/${blog.data.slug}`} class="blog-card group block reveal opacity-0 translate-y-6 transition-all duration-1000 ease-out" style={`transition-delay: ${(index % 4) * 100}ms`}>
            <div class="aspect-[4/3] rounded-[32px] overflow-hidden mb-6 relative shadow-[0_8px_30px_rgb(0,0,0,0.04)] bg-secondary">
              {blog.data.heroImage ? (
                <Image src={blog.data.heroImage} alt={blog.data.title} class="w-full h-full object-cover transition-transform duration-[2s] group-hover:scale-[1.03] opacity-90" width={500} height={375} />
              ) : (
                <div class="absolute inset-0 flex flex-col items-start justify-end p-8" style="background: linear-gradient(135deg, #4E567A 0%, #2d3454 100%)">
                  <span class="text-xs font-semibold text-white/50 uppercase tracking-widest mb-3">{blog.data.category}</span>
                  <p class="text-white font-semibold text-2xl leading-tight tracking-tight line-clamp-3 group-hover:text-primary transition-colors duration-300">{blog.data.title}</p>
                </div>
              )}
              <div class="absolute inset-0 bg-black/0 group-hover:bg-black/5 transition-colors duration-500 rounded-[32px]"></div>
            </div>
            <div class="flex items-center gap-3 text-xs font-semibold text-primary mb-4 tracking-wider uppercase">
              <span>{blog.data.category}</span>
              <span class="text-fg-muted/40">•</span>
              <span class="text-fg-muted">{blog.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
              <span class="text-fg-muted/40">•</span>
              <span class="text-fg-muted">{getReadingTime(blog.body)} read</span>
            </div>
            <h2 class="text-2xl lg:text-3xl font-semibold tracking-tight text-fg mb-3 group-hover:text-primary transition-colors leading-[1.15]">{blog.data.title}</h2>
            <p class="text-base lg:text-lg text-fg-muted font-medium leading-relaxed line-clamp-2 mb-4">{blog.data.excerpt}</p>
          </a>
        ))}
      </div>
      
      {page.data.length === 0 && (
        <div class="text-center py-12 md:py-20">
          <Icon name="search" size={48} class="mx-auto text-fg-muted/30 mb-4" />
          <h3 class="text-2xl font-semibold text-fg mb-2">No articles found</h3>
          <p class="text-fg-muted font-medium">There are no articles in this category yet.</p>
        </div>
      )}

      <!-- Pagination -->
      {page.lastPage > 1 && (
        <div class="mt-16 flex items-center justify-between border-t border-border/50 pt-8">
          {page.url.prev ? (
            <a href={page.url.prev} class="flex items-center gap-2 px-5 py-2.5 rounded-full border border-border text-fg font-medium hover:bg-secondary/5 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
              Previous
            </a>
          ) : (
            <span class="flex items-center gap-2 px-5 py-2.5 rounded-full border border-transparent text-fg-muted/30 font-medium cursor-not-allowed">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
              Previous
            </span>
          )}

          <span class="text-sm font-semibold text-fg-muted">
            Page {page.currentPage} of {page.lastPage}
          </span>

          {page.url.next ? (
            <a href={page.url.next} class="flex items-center gap-2 px-5 py-2.5 rounded-full border border-border text-fg font-medium hover:bg-secondary/5 transition-colors">
              Next
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            </a>
          ) : (
            <span class="flex items-center gap-2 px-5 py-2.5 rounded-full border border-transparent text-fg-muted/30 font-medium cursor-not-allowed">
              Next
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            </span>
          )}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
