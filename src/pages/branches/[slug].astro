---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { waHref } from '../../config/contact';

export async function getStaticPaths() {
  const branches = await getCollection('branches');
  const sortedBranches = [...branches].sort((a,b) => a.data.order - b.data.order);
  return branches.map(branch => ({
    params: { slug: branch.data.slug },
    props: { branch, allBranches: sortedBranches },
  }));
}

type Props = { branch: CollectionEntry<'branches'>; allBranches: CollectionEntry<'branches'>[] };
const { branch, allBranches } = Astro.props;
const { Content } = await render(branch);
const waLink = waHref(`Hello, I would like to book an appointment at your ${branch.data.city} clinic.`);
const others = allBranches.filter(b => b.data.slug !== branch.data.slug);
---


<BaseLayout
  title={`${branch.data.name} Clinic | Joy of Hearing`}
  description={`Joy of Hearing ${branch.data.city} — Expert audiology and speech therapy. ${branch.data.addressLine1}`}
>
  <!-- Local Clinic Schema Markup -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": ["MedicalClinic", "LocalBusiness"],
    "name": `Joy of Hearing - ${branch.data.name}`,
    "description": `Joy of Hearing ${branch.data.city} clinic providing expert audiology, hearing aid fitting, and speech therapy.`,
    "telephone": branch.data.phone || "+919548148852",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": `${branch.data.addressLine1} ${branch.data.addressLine2 || ''}`.trim(),
      "addressLocality": branch.data.city,
      "addressRegion": "Punjab",
      "addressCountry": "IN"
    },
    "url": Astro.url.href,
    "priceRange": "$$"
  })} />
  <!-- Hero -->
  <section class="pt-32 pb-16 bg-secondary text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="w-full h-full" style="background: radial-gradient(ellipse at 70% 50%, #EE3137 0%, transparent 60%)"></div>
    </div>
    <div class="max-w-6xl mx-auto px-4 relative z-10">
      <a href={import.meta.env.BASE_URL} class="inline-flex items-center gap-2 text-white/60 hover:text-white text-sm font-medium mb-8 transition-colors">
        <Icon name="arrow-left" size={16} /> All Locations
      </a>
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-semibold tracking-tighter mb-4 leading-none">
        {branch.data.name}
      </h1>
      <p class="text-xl text-white/70 font-medium">Joy of Hearing — Punjab Audiology Clinic</p>
    </div>
  </section>

  <!-- Info + Map Grid -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-12 items-start">

      <!-- Left: Info Card -->
      <div class="space-y-6">
        <div class="bg-bg-soft rounded-[28px] p-8 border border-border/40">
          <h2 class="text-2xl font-semibold tracking-tighter text-fg mb-6">Clinic <span class="text-primary">Information</span></h2>
          <ul class="space-y-5">
            <li class="flex items-start gap-4">
              <div class="w-9 h-9 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
                <Icon name="map-pin" size={18} class="text-primary" />
              </div>
              <div>
                <p class="text-xs font-semibold text-fg-muted uppercase tracking-wider mb-1">Address</p>
                <p class="text-fg font-medium leading-snug">{branch.data.addressLine1}</p>
                {branch.data.addressLine2 && <p class="text-fg font-medium leading-snug">{branch.data.addressLine2}</p>}
              </div>
            </li>
            <li class="flex items-start gap-4">
              <div class="w-9 h-9 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
                <Icon name="phone" size={18} class="text-primary" />
              </div>
              <div>
                <p class="text-xs font-semibold text-fg-muted uppercase tracking-wider mb-1">Phone</p>
                <a href={`tel:${branch.data.phone}`} class="text-fg font-medium hover:text-primary transition-colors">{branch.data.phone}</a>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <div class="w-9 h-9 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
                <Icon name="clock" size={18} class="text-primary" />
              </div>
              <div>
                <p class="text-xs font-semibold text-fg-muted uppercase tracking-wider mb-1">Hours</p>
                <p class="text-fg font-medium">{branch.data.hours}</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <div class="w-9 h-9 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
                <Icon name="mail" size={18} class="text-primary" />
              </div>
              <div>
                <p class="text-xs font-semibold text-fg-muted uppercase tracking-wider mb-1">Email</p>
                <a href="mailto:Customercare@joyofhearing.net" class="text-fg font-medium hover:text-primary transition-colors">Customercare@joyofhearing.net</a>
              </div>
            </li>
          </ul>

          <div class="mt-8 flex flex-col sm:flex-row gap-4">
            <a
              href={waLink}
              target="_blank"
              rel="noopener noreferrer"
              class="flex-1 flex items-center justify-center gap-2 bg-[#25D366] text-white rounded-full px-6 py-3 font-semibold text-sm hover:scale-105 transition-transform shadow-md"
            >
              Book via WhatsApp
            </a>
            <a
              href={`${import.meta.env.BASE_URL}contact`}
              class="flex-1 flex items-center justify-center gap-2 bg-primary text-white rounded-full px-6 py-3 font-semibold text-sm hover:bg-primary-hover hover:scale-105 transition-all shadow-md"
            >
              Request Appointment
            </a>
          </div>
        </div>

        <!-- About this clinic -->
        <div class="prose prose-base max-w-none text-fg-muted font-medium leading-relaxed">
          <Content />
        </div>
      </div>

      <!-- Right: Google Maps Embed -->
      <div class="rounded-[28px] overflow-hidden border border-border/40 shadow-lg aspect-[4/3] bg-bg-soft">
        <iframe
          src={branch.data.googleMapsEmbedUrl}
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={`Joy of Hearing ${branch.data.city} map`}
        ></iframe>
      </div>
    </div>
  </section>

  <!-- Other Locations -->
  <section class="py-16 bg-bg-soft border-t border-border/50">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl font-semibold tracking-tighter text-fg mb-8">Other Locations</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
        {others.map(b => (
          <a
            href={`${import.meta.env.BASE_URL}branches/${b.data.slug}`}
            class="flex items-center justify-center text-center px-4 py-3 rounded-2xl bg-white border border-border/40 text-fg font-medium text-sm hover:border-primary hover:text-primary transition-all duration-200 shadow-sm hover:shadow"
          >
            {b.data.name}
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

