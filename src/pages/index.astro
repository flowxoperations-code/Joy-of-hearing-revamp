---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';

// Import images for optimization
import clinicHeroImage from '../assets/images/indian_clinic_hero_1778224461642.webp';
import docPatientImage from '../assets/images/indian_homepage_consultation.webp';

import serviceImg1 from '../assets/images/indian_audiologist_consultation_1778224444440.webp';
import serviceImg2 from '../assets/images/indian_pediatric_audiology_1778224477472.webp';
import serviceImg3 from '../assets/images/indian_hearing_aid_macro_1778224495407.webp';
import serviceImg4 from '../assets/images/indian_cochlear_implant_1778228428470.webp';
import serviceImg5 from '../assets/images/indian_speech_therapy_1778228460846.webp';
import serviceImg6 from '../assets/images/indian_tinnitus_management_1778228477486.webp';
import serviceImg7 from '../assets/images/indian_hearing_protection_1778228445455.webp';
import serviceImg8 from '../assets/images/indian_patient_education_1778228521124.webp';

import bteAid from '../assets/images/bte_hearing_aid.png';
import ricAid from '../assets/images/ric_hearing_aid.png';
import iteAid from '../assets/images/ite_hearing_aid.png';
import itcAid from '../assets/images/itc_hearing_aid.png';
import cicAid from '../assets/images/cic_hearing_aid.png';
import iicAid from '../assets/images/iic_hearing_aid.png';
import earbudAid from '../assets/images/earbud_hearing_aid.png';

const serviceImages = [
  serviceImg1,
  serviceImg2,
  serviceImg3,
  serviceImg4,
  serviceImg5,
  serviceImg6,
  serviceImg7,
  serviceImg8,
];

// Fetch content
const services = await getCollection('services');
const sortedServices = services.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Joy of Hearing | Complete Hearing & Speech Solution"
  description="Leading hearing clinic & speech therapy center in India. Get expert hearing tests, advanced digital hearing aids, tinnitus care, and pediatric audiology."
>
  <!-- Hero Section -->
  <section class="relative h-[80vh] min-h-[600px] flex items-center justify-center overflow-hidden bg-secondary">
    <!-- Parallax Background Image -->
    <div class="absolute inset-0 z-0 parallax w-full h-[120%]" data-speed="0.2">
      <Image src={clinicHeroImage} alt="Joy of Hearing Clinic" class="w-full h-full object-cover opacity-50" width={1920} height={1080} loading="eager" />
      <div class="w-full h-full bg-gradient-to-b from-secondary/90 via-secondary/30 to-secondary absolute inset-0"></div>
      <!-- Logo placed in the bright top-center wall area above the headline -->
      <img src={`${import.meta.env.BASE_URL}images/logo-live.svg`} alt="Joy of Hearing Watermark" class="absolute top-[12%] left-1/2 -translate-x-1/2 w-44 md:w-56 lg:w-64 opacity-[0.22] z-10 pointer-events-none select-none" />
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 text-center mt-12">
      <h1 class="reveal opacity-0 translate-y-6 transition-all duration-1000 ease-out text-4xl sm:text-5xl md:text-7xl lg:text-[90px] font-semibold tracking-tighter text-white mb-4 leading-none drop-shadow-lg">
        Hear the <span class="text-primary drop-shadow-[0_0_15px_rgba(238,49,55,0.5)]">world.</span>
      </h1>
      <p class="reveal opacity-0 translate-y-6 transition-all duration-1000 delay-200 ease-out text-xl md:text-3xl text-white/90 max-w-3xl mx-auto font-medium mb-8 tracking-tight leading-tight">
        Clinical excellence in audiology and speech therapy, driven by over six years of <span class="text-primary font-semibold drop-shadow-md">precision</span> medical care.
      </p>
      <div class="reveal opacity-0 translate-y-6 transition-all duration-1000 delay-400 ease-out flex flex-col sm:flex-row justify-center gap-4">
        <a href={`${import.meta.env.BASE_URL}contact`} class="px-8 py-4 md:px-10 md:py-5 bg-white text-secondary rounded-full font-bold text-lg md:text-xl hover:scale-105 transition-transform duration-500 shadow-2xl w-full sm:w-auto">
          Book Consultation
        </a>
        <a href={`${import.meta.env.BASE_URL}assessment`} class="px-6 py-4 md:px-8 md:py-5 bg-transparent border border-white/20 text-white/80 rounded-full font-semibold text-base md:text-lg hover:bg-white/10 hover:text-white transition-all duration-500 backdrop-blur-sm w-full sm:w-auto">
          Screening
        </a>
      </div>
    </div>
  </section>

  <!-- Stats Strip -->
  <section class="bg-secondary border-b border-white/5 py-10 md:py-14 relative z-20">
    <div class="max-w-5xl mx-auto px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 divide-white/10 divide-y-2 divide-x-0 md:divide-y-0 md:divide-x">
        <div class="stat-item text-center px-6 py-6 md:py-0">
          <div class="text-5xl md:text-6xl font-semibold text-white tracking-tighter mb-1">
            <span class="stat-count" data-target="6">0</span><span>+</span>
          </div>
          <p class="text-white/40 text-[11px] font-semibold uppercase tracking-[0.2em] mt-2">Years of Care</p>
        </div>
        <div class="stat-item text-center px-6 py-6 md:py-0">
          <div class="text-5xl md:text-6xl font-semibold text-white tracking-tighter mb-1">
            <span class="stat-count" data-target="1" data-suffix="Lac+">0</span>
          </div>
          <p class="text-white/40 text-[11px] font-semibold uppercase tracking-[0.2em] mt-2">Patients Helped</p>
        </div>
        <div class="stat-item text-center px-6 py-6 md:py-0 border-r border-white/10">
          <div class="text-5xl md:text-6xl font-semibold text-white tracking-tighter mb-1">
            <span class="stat-count" data-target="11">0</span>
          </div>
          <p class="text-white/40 text-[11px] font-semibold uppercase tracking-[0.2em] mt-2">Clinic Locations</p>
        </div>
        <div class="stat-item text-center px-6 py-6 md:py-0">
          <div class="text-5xl md:text-6xl font-semibold text-white tracking-tighter mb-1">
            <span class="stat-count" data-target="20" data-suffix="K+">0</span>
          </div>
          <p class="text-white/40 text-[11px] font-semibold uppercase tracking-[0.2em] mt-2">Hearing Aids Fitted</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Video / Value Prop Section -->
  <section class="py-16 md:py-24 bg-white relative z-20">
    <div class="max-w-5xl mx-auto px-4 text-center mb-16">
      <h2 class="reveal opacity-0 translate-y-6 transition-all duration-1000 ease-out text-4xl md:text-6xl font-semibold tracking-tighter text-fg mb-6 leading-tight">
        <span class="text-primary">Precision</span> diagnostics.<br/><span class="text-primary">Personalized</span> rehabilitation.
      </h2>
      <p class="reveal opacity-0 translate-y-6 transition-all duration-1000 delay-200 ease-out text-xl md:text-2xl text-fg-muted font-medium leading-relaxed max-w-4xl mx-auto">
        We utilize state-of-the-art equipment to deliver accurate assessments, ensuring every patient receives a <span class="text-primary font-semibold">scientifically backed</span> hearing solution tailored to their exact physiological needs.
      </p>
    </div>
    
    <!-- Parallax Image Window -->
    <div class="max-w-6xl mx-auto px-4">
      <div class="h-[50vh] min-h-[400px] rounded-[32px] overflow-hidden relative reveal opacity-0 translate-y-6 transition-all duration-1000 delay-300 ease-out shadow-xl bg-white">
        <Image src={docPatientImage} alt="Doctor consulting patient" class="w-full h-full object-cover object-[center_30%]" width={1200} height={800} decoding="async" />
        <img src={`${import.meta.env.BASE_URL}images/logo-live.svg`} alt="Joy of Hearing Logo" class="absolute top-6 left-6 md:top-8 md:left-8 z-20 w-32 md:w-40 drop-shadow-md opacity-90" />
      </div>
    </div>
  </section>

  <!-- Services Apple-style Alternating Grid -->
  <section class="py-12 md:py-20 bg-bg-soft relative z-20 border-t border-border/50">
    <div class="max-w-6xl mx-auto px-4">
      <div class="mb-12 text-center">
        <h2 class="reveal opacity-0 translate-y-6 transition-all duration-1000 ease-out text-4xl md:text-6xl lg:text-7xl font-semibold tracking-tighter text-fg mb-4">
          Clinical <span class="text-primary">Services.</span>
        </h2>
        <p class="reveal opacity-0 translate-y-6 transition-all duration-1000 delay-200 ease-out text-xl md:text-2xl text-fg-muted max-w-2xl mx-auto font-medium leading-tight">
          Hover to explore our specialized treatments.
        </p>
      </div>

      <div class="flex flex-col lg:flex-row h-[700px] lg:h-[600px] gap-2 w-full max-w-7xl mx-auto reveal opacity-0 translate-y-6 transition-all duration-1000 delay-300 ease-out">
        {sortedServices.map((service, index) => {
          return (
            <div data-service-card class="relative flex-1 group/item hover:flex-[4] transition-[flex] duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] overflow-hidden rounded-[24px] cursor-pointer bg-secondary">
              <a href={`${import.meta.env.BASE_URL}services/${service.data.slug}`} class="absolute inset-0 z-30"><span class="sr-only">Explore {service.data.title}</span></a>
              
              <div class="absolute inset-0 w-full lg:w-[150%] h-full parallax" data-speed="0.05">
                <Image 
                  src={serviceImages[index % serviceImages.length]} 
                  class="w-full h-full object-cover opacity-60 group-hover/item:opacity-90 transition-opacity duration-700" 
                  alt={service.data.title}
                  width={600}
                  height={800}
                  decoding="async"
                />
              </div>
              <img src={`${import.meta.env.BASE_URL}images/logo-live.svg`} alt="Joy of Hearing Logo" class="absolute top-6 left-6 z-30 w-24 drop-shadow-md opacity-0 group-hover/item:opacity-90 transition-opacity duration-500 hidden md:block" />
              
              <div class="absolute inset-0 bg-gradient-to-t from-secondary/95 via-secondary/40 to-transparent z-10 transition-opacity duration-700 group-hover/item:opacity-80"></div>
              
              <div class="absolute bottom-0 left-0 w-full p-6 z-20 flex flex-col justify-end h-full">
                <div class="mb-3 text-white/80 group-hover/item:text-white transition-colors duration-500 h-6">
                </div>
                
                <h3 class="text-sm lg:text-[15px] leading-tight font-semibold tracking-tight text-white mb-0 group-hover/item:mb-3 transition-all duration-500 group-hover/item:text-2xl break-normal">
                  {service.data.title}
                </h3>
                
                <div class="grid grid-rows-[0fr] lg:group-hover/item:grid-rows-[1fr] group-hover/item:grid-rows-[1fr] transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]">
                  <div class="overflow-hidden">
                    <p class="text-white/80 text-[15px] leading-snug mb-4 max-w-[280px] opacity-0 group-hover/item:opacity-100 transition-opacity duration-700 delay-100">
                      {service.data.summary}
                    </p>
                    <span class="inline-flex items-center text-sm font-semibold text-white/90 group-hover/item:text-white pb-1">
                      Explore Treatment <Icon name="arrow-right" class="ml-2 transform group-hover/item:translate-x-1 transition-transform duration-300" size={16} />
                    </span>
                  </div>
                </div>
              </div>
            </div>
          );
        })}
      </div>
      
      <div class="text-center mt-12 reveal opacity-0 translate-y-10 transition-all duration-1000 ease-out">
        <a href={`${import.meta.env.BASE_URL}services`} class="inline-flex items-center text-xl font-semibold text-fg hover:text-primary transition-colors">
          View all clinical services
          <Icon name="arrow-right" class="ml-2 transform group-hover:translate-x-1 transition-transform duration-300" size={24} />
        </a>
      </div>
    </div>
  </section>

  <!-- Types of Hearing Aids Section -->
  <section id="hearing-aids" class="py-20 md:py-32 bg-white relative z-20 border-t border-border/50">
    <div class="max-w-6xl mx-auto px-4">

      <!-- Header -->
      <div class="text-center mb-14 reveal opacity-0 translate-y-6 transition-all duration-1000 ease-out">
        <span class="text-sm font-bold text-primary uppercase tracking-[0.2em] mb-4 block">Hearing Aid Guide</span>
        <h2 class="text-4xl md:text-6xl font-semibold tracking-tighter text-fg leading-none mb-5">Types of <span class="text-primary">Hearing Aids</span></h2>
        <p class="text-lg md:text-xl text-fg-muted font-medium max-w-2xl mx-auto leading-relaxed">
          We offer the latest in hearing technology, customized to fit your lifestyle and hearing needs.
        </p>
        <a href={`${import.meta.env.BASE_URL}services/hearing-aids`} class="inline-flex items-center gap-2 text-primary font-semibold text-sm hover:gap-3 transition-all mt-4">
          Full Range Available <Icon name="arrow-right" size={14} />
        </a>
      </div>

      <!-- Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 reveal opacity-0 translate-y-6 transition-all duration-1000 delay-100 ease-out">

        {[
          { abbr: 'BTE', name: 'BTE (Behind-The-Ear)', desc: 'Powerful and versatile, suitable for mild to profound hearing loss. Sits comfortably behind the ear.', img: bteAid },
          { abbr: 'RIC', name: 'RIC (Receiver-In-Canal)', desc: 'Discreet and comfortable with open-fitting options. Delivers sound directly into the ear canal.', img: ricAid },
          { abbr: 'ITE', name: 'ITE (In-The-Ear)', desc: 'Custom-made to fit the outer bowl of your ear. Easy to handle and suitable for various hearing losses.', img: iteAid },
          { abbr: 'ITC', name: 'ITC (In-The-Canal)', desc: 'Smaller and less noticeable than ITE. Custom-molded for a discreet and comfortable fit.', img: itcAid },
          { abbr: 'CIC', name: 'CIC (Completely-In-Canal)', desc: 'Barely visible, fitting deep inside the ear canal. Great for mild to moderate hearing loss.', img: cicAid },
          { abbr: 'IIC', name: 'IIC (Invisible-In-Canal)', desc: 'The smallest custom hearing aid, virtually invisible when worn. Perfect for cosmetic discretion.', img: iicAid },
          { abbr: 'EARBUD', name: 'Earbud Hearing Aid', desc: 'Stylish earbud-style hearing aids with clear sound and smart connectivity. Rechargeable and modern.', img: earbudAid },
        ].map((type) => (
          <a href={`${import.meta.env.BASE_URL}services/hearing-aids#${type.abbr.toLowerCase()}`}
             class="group flex flex-col bg-white shadow-[0_2px_10px_rgba(0,0,0,0.02)] rounded-3xl hover:shadow-[0_8px_30px_rgba(0,0,0,0.06)] transition-all duration-500 ease-out hover:scale-[1.01] overflow-hidden">
            <!-- Pure white image area -->
            <div class="flex items-center justify-center h-56 px-10 pt-10 pb-6 overflow-hidden">
              <Image
                src={type.img}
                alt={type.name}
                class="max-h-full w-auto object-contain group-hover:scale-105 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]"
                width={200}
                height={200}
                decoding="async"
              />
            </div>
            <!-- Text -->
            <div class="px-7 pt-5 pb-8 flex flex-col gap-2">
              <h3 class="text-xl font-semibold text-fg tracking-tight">{type.name}</h3>
              <p class="text-base text-fg-muted font-medium leading-relaxed">{type.desc}</p>
            </div>
          </a>
        ))}

      </div>


      <!-- CTA -->
      <div class="text-center mt-12 reveal opacity-0 translate-y-6 transition-all duration-1000 delay-200 ease-out">
        <a href={`${import.meta.env.BASE_URL}contact`}
           class="inline-flex items-center gap-3 px-8 py-4 bg-secondary text-white rounded-full font-semibold text-lg hover:bg-secondary/90 hover:scale-105 transition-all shadow-lg">
          Enquire About Products
        </a>
      </div>

    </div>
  </section>


  <!-- Doctor Section -->
  <section class="py-32 md:py-48 bg-secondary text-white relative z-20 overflow-hidden border-t border-white/5">
    <!-- Ambient glow -->
    <div class="absolute top-1/2 left-0 -translate-y-1/2 w-[800px] h-[800px] bg-primary/20 rounded-full blur-[140px] pointer-events-none mix-blend-screen"></div>

    <div class="max-w-7xl mx-auto px-4 grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-24 items-center relative z-10">
      
      <!-- Left: Massive Image with Glass Badge -->
      <div class="reveal opacity-0 translate-y-12 transition-all duration-1000 ease-out relative group order-2 lg:order-1">
        <div class="aspect-[4/5] rounded-[48px] overflow-hidden bg-secondary-soft relative shadow-2xl shadow-black/50 border border-white/10">
          <Image 
            src={serviceImg1}
            class="absolute inset-0 w-full h-full object-cover opacity-90 group-hover:scale-105 group-hover:opacity-100 transition-all duration-[1.5s] ease-[cubic-bezier(0.16,1,0.3,1)]" 
            alt="Expert Clinical Team"
            width={800}
            height={1000}
          />
          <img src={`${import.meta.env.BASE_URL}images/logo-live.svg`} alt="Joy of Hearing Logo" class="absolute top-8 left-8 z-20 w-40 md:w-48 drop-shadow-lg opacity-90" />
          
          <!-- Glassmorphic floating card -->
          <div class="absolute bottom-8 left-8 right-8 bg-white/10 backdrop-blur-xl border border-white/20 p-6 rounded-[32px] translate-y-8 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-700 delay-100 shadow-xl">
            <p class="text-white font-semibold text-xl tracking-tight mb-1">6+ Years of Trust</p>
            <p class="text-white/70 text-sm font-medium tracking-wide uppercase">Standardized Care Across 11 Branches</p>
          </div>
        </div>
      </div>
      
      <!-- Right: Typography -->
      <div class="reveal opacity-0 translate-y-12 transition-all duration-1000 delay-200 ease-out order-1 lg:order-2">
        <h2 class="text-6xl md:text-[5.5rem] lg:text-[7rem] font-semibold tracking-tighter mb-8 leading-[1.05]">
          Precision.<br/>
          <span class="text-primary drop-shadow-[0_0_20px_rgba(238,49,55,0.4)]">Care.</span><br/>
          Results.
        </h2>
        
        <p class="text-lg md:text-xl text-primary font-bold mb-8 tracking-[0.2em] uppercase">
          The Expert Clinical Team
        </p>
        
        <p class="text-xl md:text-3xl text-white/70 font-medium leading-relaxed mb-12 max-w-xl">
          Driven by a relentless commitment to evidence-based audiology, we rely on exact diagnostics to engineer personalized rehabilitation. Our singular focus is your <span class="text-primary font-semibold">long-term outcome.</span>
        </p>
        
        <a href={`${import.meta.env.BASE_URL}about#expertise`} class="group inline-flex items-center gap-4 text-2xl font-semibold text-white transition-colors duration-300">
          <span class="border-b-2 border-transparent group-hover:border-white pb-1 transition-all duration-300">Explore our care standards</span>
          <div class="w-14 h-14 rounded-full bg-white/10 flex items-center justify-center group-hover:bg-primary group-hover:text-white group-hover:scale-110 transition-all duration-500 shadow-lg">
            <Icon name="arrow-right" size={24} />
          </div>
        </a>
      </div>
      
    </div>
  </section>

  <TestimonialsSection />

  <!-- Script for Animated Stat Counters -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Animated stat counters
      const statObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          const target = parseInt(el.dataset.target || '0');
          const suffix = el.dataset.suffix || '';
          const duration = 1400;
          const startTime = performance.now();
          const update = (now: number) => {
            const elapsed = now - startTime;
            const progress = Math.min(elapsed / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 3);
            el.textContent = Math.round(eased * target).toLocaleString() + suffix;
            if (progress < 1) requestAnimationFrame(update);
          };
          requestAnimationFrame(update);
          statObserver.unobserve(el);
        });
      }, { threshold: 0.5 });
      document.querySelectorAll('.stat-count').forEach(el => statObserver.observe(el));
    });
  </script>


  <script>
    // Mobile tap-to-expand for service cards
    document.addEventListener('DOMContentLoaded', () => {
      const isTouchPrimary = window.matchMedia('(hover: none) and (pointer: coarse)').matches;
      if (!isTouchPrimary) return;
      const cards = document.querySelectorAll<HTMLElement>('[data-service-card]');
      cards.forEach(card => {
        card.addEventListener('click', (e) => {
          const isExpanded = card.style.flex === '4 4 0%' || card.style.flexGrow === '4';
          cards.forEach(c => { c.style.flex = ''; });
          if (!isExpanded) card.style.flex = '4 4 0%';
        });
      });
    });
  </script>
</BaseLayout>
