---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQItem from '../../components/FAQItem.astro';
import Icon from '../../components/Icon.astro';
import { Image } from 'astro:assets';

// Import images for optimization
import serviceImg1 from '../../assets/images/indian_audiologist_consultation_1778224444440.webp';
import serviceImg2 from '../../assets/images/indian_pediatric_audiology_1778224477472.webp';
import serviceImg3 from '../../assets/images/indian_hearing_aid_macro_1778224495407.webp';
import serviceImg4 from '../../assets/images/indian_cochlear_implant_1778228428470.webp';
import serviceImg5 from '../../assets/images/indian_speech_therapy_1778228460846.webp';
import serviceImg6 from '../../assets/images/indian_tinnitus_management_1778228477486.webp';
import serviceImg7 from '../../assets/images/indian_hearing_protection_1778228445455.webp';
import serviceImg8 from '../../assets/images/indian_patient_education_1778228521124.webp';

const services = await getCollection('services');
const sortedServices = services.sort((a, b) => a.data.order - b.data.order);
const faqs = await getCollection('faqs');

const base = import.meta.env.BASE_URL;

const genericImages = [
  serviceImg1,
  serviceImg2,
  serviceImg3,
  serviceImg4,
  serviceImg5,
  serviceImg6,
  serviceImg7,
  serviceImg8,
  serviceImg3,
  serviceImg8,
];
---

<BaseLayout 
  title="Clinical Hearing & Speech Services | Joy of Hearing"
  description="Explore specialized hearing and speech therapy services at Joy of Hearing, including diagnostic tests, hearing aid fitting, tinnitus care & cochlear implants."
>
  <!-- FAQ Schema Markup -->
  {faqs && faqs.length > 0 && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map(faq => ({
        "@type": "Question",
        "name": faq.data.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.data.answer
        }
      }))
    })} />
  )}
  <section class="pt-32 pb-12 max-w-6xl mx-auto px-4 text-center">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="Breadcrumb" class="mb-6 reveal opacity-0 translate-y-6 transition-all duration-1000 ease-out">
      <ol class="flex items-center justify-center space-x-2 text-sm font-medium text-fg-muted overflow-hidden whitespace-nowrap">
        <li>
          <a href={`${base}`} class="hover:text-primary transition-colors">Home</a>
        </li>
        <li>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-fg-muted/40"><path d="m9 18 6-6-6-6"/></svg>
        </li>
        <li class="text-fg truncate" aria-current="page">
          Services
        </li>
      </ol>
    </nav>

    <h1 class="reveal opacity-0 translate-y-6 transition-all duration-1000 ease-out text-4xl md:text-6xl lg:text-7xl font-semibold tracking-tighter text-fg mb-4 leading-none">
      Clinical <span class="text-primary drop-shadow-[0_0_15px_rgba(238,49,55,0.2)]">Services.</span>
    </h1>
    <p class="reveal opacity-0 translate-y-6 transition-all duration-1000 delay-200 ease-out text-xl md:text-2xl text-fg-muted max-w-2xl mx-auto font-medium leading-tight">
      <span class="text-primary font-semibold">Evidence-based</span> audiology and speech therapy.
    </p>
  </section>

  <section class="py-10 bg-white">
    {sortedServices.map((service, index) => {
      const isEven = index % 2 === 0;
      return (
        <div class="max-w-6xl mx-auto px-4 py-16 border-t border-border/40 first:border-0">
          <div class={`flex flex-col ${isEven ? 'md:flex-row' : 'md:flex-row-reverse'} gap-12 md:gap-16 items-center`}>
            
            <!-- Image Side -->
            <div class="w-full md:w-1/2 reveal opacity-0 translate-y-6 transition-all duration-1000 ease-out">
              <div class="aspect-[4/3] overflow-hidden rounded-[32px] bg-bg-soft relative group">
                <Image 
                  src={genericImages[index]} 
                  alt={service.data.title}
                  class="w-full h-full object-cover transition-transform duration-[2s] group-hover:scale-105"
                  loading={index < 2 ? "eager" : "lazy"}
                  width={600}
                  height={450}
                />
                <img src={`${import.meta.env.BASE_URL}images/logo-live.svg`} alt="Joy of Hearing Logo" class="absolute top-6 left-6 md:top-8 md:left-8 z-20 w-28 md:w-36 drop-shadow-md opacity-90" />
              </div>
            </div>

            <!-- Text Side -->
            <div class="w-full md:w-1/2 reveal opacity-0 translate-y-6 transition-all duration-1000 delay-200 ease-out">
              <div class="mb-4 text-primary h-6">
              </div>
              <h2 class="text-3xl md:text-5xl font-semibold tracking-tighter text-fg mb-6">{service.data.title}</h2>
              <p class="text-lg md:text-xl text-fg-muted leading-relaxed mb-8">{service.data.summary}</p>
              
              <ul class="space-y-4 mb-10">
                {service.data.whatToExpect.slice(0, 3).map((item: string) => (
                  <li class="flex items-start text-lg text-fg font-medium">
                    <Icon name="check-circle" size={20} class="mr-3 text-primary shrink-0 mt-1" />
                    {item}
                  </li>
                ))}
              </ul>
              
              <a href={`${base}services/${service.data.slug}`} class="inline-flex items-center text-xl font-semibold text-primary group hover:text-primary-hover transition-colors">
                Explore {service.data.title.toLowerCase()} 
                <Icon name="arrow-right" class="ml-2 transform group-hover:translate-x-1 transition-transform duration-300" size={24} />
              </a>
            </div>
          </div>
        </div>
      );
    })}
  </section>

  <section class="max-w-3xl mx-auto py-16 md:py-24 px-4 reveal opacity-0 translate-y-6 transition-all duration-1000 ease-out">
    <div class="text-center mb-12">
      <h2 class="text-4xl md:text-5xl font-semibold text-fg tracking-tighter">Frequently Asked <span class="text-primary">Questions</span></h2>
    </div>
    <div class="border-t border-border">
      {faqs.map(faq => (
        <FAQItem question={faq.data.question} answer={faq.data.answer} />
      ))}
    </div>
  </section>

  <section class="bg-bg-soft py-16 md:py-24 text-center px-4 reveal opacity-0 translate-y-6 transition-all duration-1000 ease-out">
    <h2 class="text-4xl md:text-6xl font-semibold mb-6 tracking-tighter text-fg">Need help <span class="text-primary">deciding?</span></h2>
    <p class="text-xl md:text-2xl text-fg-muted mb-10 max-w-2xl mx-auto font-medium">Our specialists are here to guide you to the <span class="text-primary font-semibold">right</span> service.</p>
    <a href={`${base}contact`} class="inline-block px-8 py-4 bg-primary text-white rounded-full font-semibold text-lg hover:bg-primary-hover hover:scale-105 transition-all duration-300 shadow-lg">
      Book a Consultation
    </a>
  </section>
  
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.remove('opacity-0', 'translate-y-10');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1, rootMargin: "0px 0px -50px 0px" });

      document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    });
  </script>
</BaseLayout>
