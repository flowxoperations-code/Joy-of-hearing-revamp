---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Thank You | Joy of Hearing" description="Thank you for reaching out to us. We will get back to you shortly.">
  <div class="min-h-[70vh] flex items-center justify-center bg-bg relative overflow-hidden">
    <!-- Background Elements -->
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-primary/5 rounded-full blur-[100px] pointer-events-none mix-blend-multiply"></div>
    <div class="absolute bottom-1/4 right-1/4 w-[500px] h-[500px] bg-green-500/5 rounded-full blur-[120px] pointer-events-none mix-blend-multiply"></div>

    <div class="text-center relative z-10 px-4">
      <div class="inline-flex items-center justify-center w-24 h-24 rounded-full bg-green-50 text-green-500 mb-8 shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round" class="opacity-80"><polyline points="20 6 9 17 4 12"></polyline></svg>
      </div>
      <h1 class="text-5xl md:text-6xl font-bold text-fg mb-4 tracking-tighter">Thank You!</h1>
      <h2 class="text-xl md:text-2xl font-semibold text-fg-muted mb-4">Your message has been successfully sent.</h2>
      <p class="text-fg-muted mb-10 max-w-md mx-auto text-lg">
        We appreciate you contacting Joy of Hearing. One of our specialists will review your information and get back to you shortly.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href={import.meta.env.BASE_URL} class="px-8 py-4 bg-primary text-white rounded-xl font-semibold shadow-lg shadow-primary/25 hover:bg-primary-hover hover:-translate-y-1 transition-all w-full sm:w-auto text-center">
          Back to Homepage
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
